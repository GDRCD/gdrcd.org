{
    "name": "gdrcd.org",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "build": "pnpm -r build",
        "check": "pnpm -r check",
        "docs:dev": "pnpm --filter @gdrcd/docs dev",
        "docs:build": "pnpm --filter @gdrcd/docs build",
        "docs:preview": "pnpm --filter @gdrcd/docs preview",
        "landing:dev": "pnpm --filter @gdrcd/landing dev",
        "landing:build": "pnpm --filter @gdrcd/landing build",
        "landing:preview": "pnpm --filter @gdrcd/landing preview",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx,astro}": [
            "oxlint --type-aware --fix",
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "*.{json,jsonc,md,css,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
    },
    "engines": {
        "node": ">=22.23.4"
    }
}
